{
    "name": "nicoverbruggen/image-generator",
    "description": "Generate placeholder images with a specific size, color and text (optional).",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nico Verbruggen",
            "email": "mail@nicoverbruggen.be"
        }
    ],
    "autoload": {
        "psr-4": {
            "NicoVerbruggen\\ImageGenerator\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-gd" : "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "ext-fileinfo": "*"
    },
    "scripts": {
        "test": "./vendor/bin/phpunit tests",
        "verify": [
            "@test"
        ]
    }
}
